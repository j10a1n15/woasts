{
    "text": {
        "autoconfig": {
            "woasts": {
                "title": "Woasts!",

                "option": {
                    "mainSwitch": {
                        "@": "Main Switch",
                        "@Tooltip": "Controls the rendering of all widgets."
                    },

                    "renderCorner": {
                        "@": "Render Corner",
                        "@Tooltip": "Specifies in which corner of the screen the widgets will be rendered.",

                        "upLeft": "Upper-Left",
                        "upRight": "Upper-Right",
                        "downLeft": "Lower-Left",
                        "downRight": "Lower-Right"
                    },

                    "margin": {
                        "@": "Margin",
                        "@Tooltip": "Specifies the margin from the edges of the screen."
                    },

                    "spacing": {
                        "@": "Spacing",
                        "@Tooltip": "Specifies the spacing between each widget."
                    },

                    "wrap": {
                        "@": "Wrap",
                        "@Tooltip": [
                            "Specifies the number of widgets allowed on a single line before wrapping.",
                            "Setting the value to zero or lower disables this feature."
                        ]
                    },

                    "wrapSpacing": {
                        "@": "Wrap Spacing",
                        "@Tooltip": "Specifies the amount of spacing between each wrapped line."
                    },

                    "pingConfig": {
                        "@": "Ping Widget",
                        "isEnabled": "Enabled",

                        "updateTime": {
                            "@": "Update Time",
                            "@Tooltip": "Specifies the amount of time (in seconds) between each ping update."
                        },

                        "greenPingRange": {
                            "@": "Green Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the green color.",
                                "",
                                "Follows the formula:",
                                "From [1] to [Value]"
                            ]
                        },

                        "yellowPingRange": {
                            "@": "Yellow Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the yellow color.",
                                "",
                                "Follows the formula, where X is the sum of all previous values:",
                                "From [X + 1] to [X + Value]"
                            ]
                        },

                        "orangePingRange": {
                            "@": "Orange Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the orange color.",
                                "",
                                "Follows the formula, where X is the sum of all previous values:",
                                "From [X + 1] to [X + Value]",
                                "",
                                "All ping values after this range will result in the red ping color."
                            ]
                        },

                        "grayPingColor": "Gray Ping Color",
                        "greenPingColor": "Green Ping Color",
                        "yellowPingColor": "Yellow Ping Color",
                        "orangePingColor": "Orange Ping Color",
                        "redPingColor": "Red Ping Color"
                    },

                    "positionConfig": {
                        "@": "Position Widget",
                        "isEnabled": "Enabled",
                        "color": "Color"
                    },

                    "fpsConfig": {
                        "@": "FPS Widget",
                        "isEnabled": "Enabled",

                        "optimalFps": {
                            "@": "Optimal FPS",
                            "@Tooltip": [
                                "Specifies the FPS value for widget coloring.",
                                "",
                                "Values below optimal FPS will be colored yellow.",
                                "Values above optimal FPS will be colored green."
                            ]
                        },

                        "greenFpsColor": "Green FPS Color",
                        "yellowFpsColor": "Yellow FPS Color"
                    }
                }
            }
        }
    }
}